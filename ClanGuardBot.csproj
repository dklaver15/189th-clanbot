<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClanGuardBot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.412.0" />
    <PackageReference Include="Discord.Net" Version="3.17.2" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.72.0.3966" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.68.0.3573" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.68.0.3502" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.76.0.4262" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="1.8.13" />

    <!--
      Downscales oversized event banner images before they're stored/attached
      (EventImage.Downscale). 2.1.9 is the last Apache-2.0 release; the
      load/resize/SaveAs* API used is identical on 3.x if ever bumped (3.x uses
      the Six Labors Split License, free for this project's scale).
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />

    <!--
      Chart rendering for the /timeline command. ScottPlot 5 produces PNG
      bytes directly via Plot.GetImageBytes(); we attach the result to
      Discord embeds using FileAttachment + the attachment:// embed-image URL.

      We do NOT need an explicit SkiaSharp.NativeAssets.Linux.NoDependencies
      reference: ScottPlot 5.1.58 already takes a transitive dependency on
      that package at >= 3.119.0, which ships the self-contained
      libSkiaSharp.so binary needed for headless rendering on the Debian
      aspnet:8.0 base image. The matching font / freetype system packages
      are installed in the Dockerfile so SkiaSharp can locate a typeface.
    -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
  </ItemGroup>

  <!--
    Static assets bundled with the bot binary. Files listed here are copied
    into the publish output (and therefore into /app inside the runtime
    Docker image), making them available at runtime via AppContext.BaseDirectory.
    Used by PromotionService for the 189th logo footer on auto-promotion
    announcements.
  -->
  <ItemGroup>
    <Content Include="Assets\189th_logo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Waving 189th flag banner: the default image attached to /poll embeds
         (PollImage). Per-poll custom images/GIFs/Giphy links override it. -->
    <Content Include="Assets\189th_banner.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Recorder\src\" />
    <Folder Include="RedditLeads\" />
    <Folder Include="Tools\" />
    <Folder Include="Transcriber\" />
  </ItemGroup>

  <!--
    ── BuildInfo source-size constants ────────────────────────────────────
    Emits obj/$(Configuration)/$(TargetFramework)/BuildInfo.g.cs containing
    `internal static class BuildInfo` with `SourceFileCount` / `SourceLineCount`
    consts. Consumed by HealthCommandHandler so /health can report codebase
    size without scanning the filesystem at runtime (production runs from
    a Docker image that ships only compiled DLLs — no .cs files on disk).

    "Hand-written" excludes:
      • EF Core Migrations/ (generated by `dotnet ef migrations add`)
      • Anything in bin/ or obj/ (build output)
      • SDK-generated *.g.cs, *.Designer.cs, AssemblyInfo.cs

    Line count is **non-blank** lines: every line that contains at least
    one non-whitespace character. Uses File.ReadAllLines so each file's
    line boundaries are computed independently (no spillover from a
    missing trailing newline into the next file).
  -->
  <UsingTask
          TaskName="CountSourceLines"
          TaskFactory="RoslynCodeTaskFactory"
          AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <CommitCountRaw ParameterType="System.String" Required="false" />
      <FileCount ParameterType="System.Int32" Output="true" />
      <LineCount ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        int files = 0;
        int lines = 0;
        foreach (var item in SourceFiles)
        {
            var path = item.GetMetadata("FullPath");
            if (!File.Exists(path)) continue;
            files++;
            // Non-blank lines only: skip lines that are empty or whitespace-only.
            // ReadAllLines transparently handles \n and \r\n endings.
            foreach (var line in File.ReadAllLines(path))
            {
                for (int i = 0; i < line.Length; i++)
                {
                    if (!char.IsWhiteSpace(line[i])) { lines++; break; }
                }
            }
        }
        FileCount = files;
        LineCount = lines;

        // CommitCountRaw is the stdout of `git rev-list --count HEAD`, captured
        // via ConsoleToMSBuild. It may arrive with trailing newlines or, if the
        // Exec was skipped (git absent / not a repo), be empty. Strip to digits
        // and parse defensively so a stray character can never break the build;
        // 0 means "unavailable" (a real repo always has >= 1 commit).
        int commits = 0;
        if (!string.IsNullOrEmpty(CommitCountRaw))
        {
            var digits = new string(Array.FindAll(CommitCountRaw.ToCharArray(), char.IsDigit));
            int.TryParse(digits, out commits);
        }

        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated />");
        sb.AppendLine("// Generated by ClanGuardBot.csproj 'GenerateBuildInfo' target.");
        sb.AppendLine("// Do not edit by hand — regenerated on every build.");
        sb.AppendLine("namespace ClanGuardBot;");
        sb.AppendLine();
        sb.AppendLine("internal static class BuildInfo");
        sb.AppendLine("{");
        sb.AppendLine("    /// <summary>Number of hand-written .cs files compiled into the bot</summary>");
        sb.AppendLine("    public const int SourceFileCount = " + files + ";");
        sb.AppendLine("    /// <summary>Non-blank lines across those files (lines with at least one non-whitespace char)</summary>");
        sb.AppendLine("    public const int SourceLineCount = " + lines + ";");
        sb.AppendLine("    /// <summary>git rev-list --count HEAD at build time; 0 when git was unavailable (e.g. built outside a repo)</summary>");
        sb.AppendLine("    public const int CommitCount = " + commits + ";");
        sb.AppendLine("}");

        var dir = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir)) Directory.CreateDirectory(dir);
        // Avoid rewriting the file when the contents are unchanged — keeps
        // incremental builds incremental (a touched .g.cs forces recompile).
        var newContent = sb.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != newContent)
            File.WriteAllText(OutputFile, newContent);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <!--
      Filter @(Compile) down to "ours". MSBuild's %(FileName) is the
      filename without extension, so `.g.cs` → "*.g" and `.Designer.cs` →
      "*.Designer". Path separator handling: normalise to forward slashes
      so the same condition works on macOS dev boxes and the Linux build
      container alike.
    -->
    <ItemGroup>
      <_BuildInfoSource Include="@(Compile)"
                        Condition="!$([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/Migrations/'))
                   AND !$([System.String]::Copy('%(Identity)').Replace('\','/').StartsWith('Migrations/'))
                   AND !$([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/obj/'))
                   AND !$([System.String]::Copy('%(Identity)').Replace('\','/').StartsWith('obj/'))
                   AND !$([System.String]::Copy('%(FileName)').EndsWith('.g'))
                   AND !$([System.String]::Copy('%(FileName)').EndsWith('.Designer'))
                   AND '%(FileName)' != 'AssemblyInfo'" />
    </ItemGroup>

    <!--
      Commit count, baked in alongside the size metrics. Runs git at build
      time because production runs from a Docker image that ships only DLLs —
      but the build STAGE copies the full repo (.git included; there is no
      .dockerignore), and the dotnet SDK image bundles git, so the count is
      accurate for the deployed commit. safe.directory='*' avoids git's
      dubious-ownership abort when the build user differs from the .git owner.
      ContinueOnError keeps a git-less build (or a shallow clone) from failing —
      the task parses an empty/garbage capture down to 0 ("unavailable").
      NOTE: if you ever move the build to GitHub-hosted CI, set the checkout's
      fetch-depth to 0, or a shallow clone will report a commit count of 1.
    -->
    <Exec Command="git -c safe.directory='*' rev-list --count HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BuildInfoCommitCountRaw" />
    </Exec>

    <CountSourceLines
            SourceFiles="@(_BuildInfoSource)"
            OutputFile="$(IntermediateOutputPath)BuildInfo.g.cs"
            CommitCountRaw="$(_BuildInfoCommitCountRaw)">
      <Output TaskParameter="FileCount" PropertyName="_BuildInfoFileCount" />
      <Output TaskParameter="LineCount" PropertyName="_BuildInfoLineCount" />
    </CountSourceLines>

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>

    <Message Importance="high"
             Text="ClanGuardBot: BuildInfo → $(_BuildInfoFileCount) files, $(_BuildInfoLineCount) lines, commits=$(_BuildInfoCommitCountRaw)" />
  </Target>

</Project>