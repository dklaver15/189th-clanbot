# Token for the SECOND Discord application (the recorder bot) — NOT the main
# ClanGuard bot token. Create it at https://discord.com/developers/applications
RECORDER_BOT_TOKEN=

# Shared secret the main bot sends as the x-recorder-secret header.
# Must match BotConfig__MeetingRecorderSharedSecret on the C# side.
# Generate one with: openssl rand -hex 32
RECORDER_SHARED_SECRET=

# Port the control API listens on inside the container (not published to host).
RECORDER_PORT=8080

# Where per-meeting audio dirs are written. Mount the same shared volume at
# this same path in the main bot container so it can read the recordings.
AUDIO_ROOT=/app/data/recordings

# Optional tuning:
# RECORDER_SILENCE_MS=800           # ms of silence that ends an utterance segment
# RECORDER_AUTO_STOP_GRACE_MS=60000 # grace past expectedStop before force-finalize
