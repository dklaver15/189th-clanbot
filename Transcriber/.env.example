# Shared secret the C# bot sends as the x-transcriber-secret header.
# Must match BotConfig__MeetingTranscriberSharedSecret on the C# side.
# Generate one with: openssl rand -hex 32
TRANSCRIBER_SHARED_SECRET=

TRANSCRIBER_PORT=8090

# faster-whisper model. base.en is a good CPU default; small.en is more
# accurate but slower and uses more RAM. Bake the model at build time via the
# Dockerfile's WHISPER_MODEL build-arg to match this.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# WHISPER_BEAM_SIZE=1     # 1 = fast/greedy; raise (e.g. 5) for accuracy
# WHISPER_LANGUAGE=en
